// Clinic/Hospital Internal Management System - Database Schema
// PostgreSQL + Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// CORE ORGANIZATION MODULE
// ============================================================================

/// Công ty/Tập đoàn
model Organization {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  nameEn          String?
  taxCode         String?
  address         String?
  phone           String?
  email           String?
  logoUrl         String?
  legalRep        String?
  status          String   @default("ACTIVE") // ACTIVE, INACTIVE
  settings        Json?    // Configuration settings
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  updatedBy       String?
  deletedAt       DateTime?

  branches        Branch[]
  departments     Department[]
  users           User[]
  auditLogs       AuditLog[]

  @@index([code])
  @@index([status])
}

/// Chi nhánh/Cơ sở
model Branch {
  id              String   @id @default(cuid())
  organizationId  String
  code            String
  name            String
  nameEn          String?
  address         String?
  province        String?  // Tỉnh/Thành
  district        String?  // Quận/Huyện
  ward            String?  // Phường/Xã
  phone           String?
  email           String?
  workingHours    Json?    // {monday: {open: "08:00", close: "17:00"}, ...}
  status          String   @default("ACTIVE")
  settings        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  updatedBy       String?
  deletedAt       DateTime?

  organization    Organization @relation(fields: [organizationId], references: [id])
  departments     Department[]
  employees       Employee[]
  warehouses      Warehouse[]
  appointments    Appointment[]
  invoices        Invoice[]
  cashSessions    CashSession[]
  assets          Asset[]
  procurementRequests ProcurementRequest[]
  purchaseOrders  PurchaseOrder[]

  @@index([organizationId])
  @@index([code])
  @@index([status])
  @@unique([organizationId, code])
}

/// Phòng ban/Khoa/Bộ phận
model Department {
  id              String   @id @default(cuid())
  organizationId  String?
  branchId        String?
  parentId        String?
  code            String
  name            String
  nameEn          String?
  description     String?
  managerId       String?
  level           Int      @default(1)
  order           Int      @default(0)
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  updatedBy       String?
  deletedAt       DateTime?

  organization    Organization? @relation(fields: [organizationId], references: [id])
  branch          Branch?  @relation(fields: [branchId], references: [id])
  parent          Department? @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children        Department[] @relation("DepartmentHierarchy")
  manager         Employee? @relation("DepartmentManager", fields: [managerId], references: [id])
  employees       Employee[]
  positions       Position[]

  @@index([organizationId])
  @@index([branchId])
  @@index([parentId])
  @@index([code])
}

/// Chức danh/Vị trí
model Position {
  id              String   @id @default(cuid())
  departmentId    String?
  code            String
  name            String
  nameEn          String?
  level           Int      @default(1)
  description     String?
  requirements    String?
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  updatedBy       String?
  deletedAt       DateTime?

  department      Department? @relation(fields: [departmentId], references: [id])
  employees       Employee[]

  @@index([departmentId])
  @@index([code])
  @@unique([code, departmentId])
}

// ============================================================================
// USER & AUTHENTICATION MODULE
// ============================================================================

/// Người dùng hệ thống
model User {
  id              String   @id @default(cuid())
  organizationId  String
  email           String
  username        String
  passwordHash    String
  firstName       String
  lastName        String
  fullName        String
  avatarUrl       String?
  phone           String?
  branchId        String?
  departmentId    String?
  positionId      String?
  status          String   @default("ACTIVE") // ACTIVE, INACTIVE, LOCKED
  lastLoginAt     DateTime?
  lastLoginIp     String?
  mustChangePassword Boolean @default(false)
  mfaEnabled      Boolean  @default(false)
  mfaSecret       String?
  settings        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  updatedBy       String?
  deletedAt       DateTime?

  organization    Organization @relation(fields: [organizationId], references: [id])
  branch          Branch?  @relation(fields: [branchId], references: [id])
  department      Department? @relation(fields: [departmentId], references: [id])
  position        Position? @relation(fields: [positionId], references: [id])
  employee        Employee?
  roles           UserRole[]
  sessions        Session[]
  auditLogs       AuditLog[]
  createdAuditLogs AuditLog[] @relation("CreatedByUser")
  updatedAuditLogs AuditLog[] @relation("UpdatedByUser")

  @@index([organizationId])
  @@index([email])
  @@index([username])
  @@index([status])
  @@unique([organizationId, email])
  @@unique([organizationId, username])
}

/// Vai trò (Role)
model Role {
  id              String   @id @default(cuid())
  organizationId  String?
  code            String
  name            String
  nameEn          String?
  description     String?
  isSystem        Boolean  @default(false) // System roles cannot be deleted
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  updatedBy       String?
  deletedAt       DateTime?

  organization    Organization? @relation(fields: [organizationId], references: [id])
  permissions     RolePermission[]
  users           UserRole[]

  @@index([organizationId])
  @@index([code])
  @@unique([organizationId, code])
}

/// Phân quyền (Permission)
model Permission {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  nameEn          String?
  module          String   // ORG, HRM, REC, CRM, FIN, INV, PROC, AST, TSK, RPT
  action          String   // CREATE, READ, UPDATE, DELETE, APPROVE, EXPORT, etc.
  resource        String   // BRANCH, EMPLOYEE, CUSTOMER, etc.
  description     String?
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  rolePermissions RolePermission[]

  @@index([module])
  @@index([action])
  @@index([resource])
}

/// Mapping Role-Permission
model RolePermission {
  id              String   @id @default(cuid())
  roleId          String
  permissionId    String
  createdAt       DateTime @default(now())
  createdBy       String?

  role            Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission      Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

/// Mapping User-Role
model UserRole {
  id              String   @id @default(cuid())
  userId          String
  roleId          String
  branchId        String?  // Role can be scoped to a branch
  grantedAt       DateTime @default(now())
  grantedBy       String?
  expiresAt       DateTime?
  createdAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role            Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  branch          Branch?  @relation(fields: [branchId], references: [id])

  @@unique([userId, roleId, branchId])
  @@index([userId])
  @@index([roleId])
}

/// Session quản lý đăng nhập
model Session {
  id              String   @id @default(cuid())
  userId          String
  token           String   @unique
  refreshToken    String   @unique
  deviceInfo      String?
  ipAddress       String?
  userAgent       String?
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  lastActiveAt    DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ============================================================================
// HRM - HUMAN RESOURCE MANAGEMENT
// ============================================================================

/// Nhân viên
model Employee {
  id              String   @id @default(cuid())
  userId          String?  @unique
  organizationId  String
  branchId        String
  departmentId    String?
  positionId      String?
  managerId       String?
  employeeCode    String
  firstName       String
  lastName        String
  fullName        String
  gender          String?  // MALE, FEMALE, OTHER
  dateOfBirth     DateTime?
  phone           String?
  email           String?
  address         String?
  province        String?
  district        String?
  ward            String?
  idType          String?  // CCCD, CMND, PASSPORT
  idNumber        String?
  taxCode         String?
  socialInsuranceNo String?
  joinDate        DateTime
  terminationDate DateTime?
  status          String   @default("ACTIVE")
  notes           String?
  profileImageUrl String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  updatedBy       String?
  deletedAt       DateTime?

  organization    Organization @relation(fields: [organizationId], references: [id])
  branch          Branch     @relation(fields: [branchId], references: [id])
  department      Department? @relation(fields: [departmentId], references: [id])
  position        Position?  @relation(fields: [positionId], references: [id])
  manager         Employee?  @relation("EmployeeManager", fields: [managerId], references: [id])
  subordinates    Employee[] @relation("EmployeeManager")
  user            User?      @relation(fields: [userId], references: [id])
  contracts       EmployeeContract[]
  workSchedules   WorkSchedule[]
  attendanceLogs  AttendanceLog[]
  leaveRequests   LeaveRequest[]
  assignedAssets  AssetAssignment[]
  departmentManagers Department[] @relation("DepartmentManager")

  @@index([organizationId])
  @@index([branchId])
  @@index([employeeCode])
  @@index([status])
  @@unique([organizationId, employeeCode])
}

/// Hợp đồng lao động
model EmployeeContract {
  id              String   @id @default(cuid())
  employeeId      String
  contractType    String   // PERMANENT, FIXED_TERM, PART_TIME, CONTRACTOR
  contractNo      String
  startDate       DateTime
  endDate         DateTime?
  salary          Decimal  @db.Decimal(15, 2)
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  updatedBy       String?
  deletedAt       DateTime?

  employee        Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([status])
}

/// Ca làm việc
model WorkShift {
  id              String   @id @default(cuid())
  organizationId  String
  branchId        String?
  code            String
  name            String
  startTime       String   // HH:mm format
  endTime         String   // HH:mm format
  isOvernight     Boolean  @default(false)
  workingHours    Decimal  @db.Decimal(4, 2)
  color           String?
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  updatedBy       String?
  deletedAt       DateTime?

  organization    Organization @relation(fields: [organizationId], references: [id])
  branch          Branch?  @relation(fields: [branchId], references: [id])
  workSchedules   WorkSchedule[]

  @@index([organizationId])
  @@index([branchId])
  @@index([code])
}

/// Lịch làm việc
model WorkSchedule {
  id              String   @id @default(cuid())
  employeeId      String
  branchId        String
  shiftId         String
  scheduleDate    DateTime @db.Date
  notes           String?
  status          String   @default("SCHEDULED")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  updatedBy       String?

  employee        Employee @relation(fields: [employeeId], references: [id])
  branch          Branch   @relation(fields: [branchId], references: [id])
  shift           WorkShift @relation(fields: [shiftId], references: [id])

  @@index([employeeId])
  @@index([branchId])
  @@index([scheduleDate])
  @@unique([employeeId, scheduleDate, shiftId])
}

/// Chấm công
model AttendanceLog {
  id              String   @id @default(cuid())
  employeeId      String
  branchId        String
  attendanceDate  DateTime @db.Date
  checkInTime     DateTime?
  checkOutTime    DateTime?
  type            String   @default("NORMAL")
  status          String   @default("PRESENT")
  workingHours    Decimal? @db.Decimal(4, 2)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  employee        Employee @relation(fields: [employeeId], references: [id])
  branch          Branch   @relation(fields: [branchId], references: [id])

  @@index([employeeId])
  @@index([branchId])
  @@index([attendanceDate])
  @@unique([employeeId, attendanceDate])
}

/// Đơn xin nghỉ phép
model LeaveRequest {
  id              String   @id @default(cuid())
  employeeId      String
  leaveType       String   // ANNUAL, SICK, PERSONAL, UNPAID
  startDate       DateTime @db.Date
  endDate         DateTime @db.Date
  totalDays       Decimal  @db.Decimal(5, 2)
  reason          String?
  approverId      String?
  approvalStatus  String   @default("PENDING")
  approvedAt      DateTime?
  rejectionReason String?
  status          String   @default("PENDING")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  updatedBy       String?
  deletedAt       DateTime?

  employee        Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([approvalStatus])
  @@index([startDate])
}

// ============================================================================
// CRM & CUSTOMER MODULE
// ============================================================================

/// Khách hàng (hồ sơ hành chính)
model Customer {
  id              String   @id @default(cuid())
  organizationId  String
  customerCode    String
  firstName       String
  lastName        String
  fullName        String
  gender          String?
  dateOfBirth     DateTime?
  phone           String
  altPhone        String?
  email           String?
  address         String?
  province        String?
  district        String?
  ward            String?
  source          String?  // WALK_IN, PHONE, WEBSITE, FACEBOOK, ZALO
  customerType    String   @default("INDIVIDUAL")
  priority        String   @default("NORMAL")
  notes           String?
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  updatedBy       String?
  deletedAt       DateTime?

  organization    Organization @relation(fields: [organizationId], references: [id])
  appointments    Appointment[]
  invoices        Invoice[]
  contacts        CustomerContact[]

  @@index([organizationId])
  @@index([customerCode])
  @@index([phone])
  @@index([status])
  @@unique([organizationId, customerCode])
}

/// Liên hệ khách hàng
model CustomerContact {
  id              String   @id @default(cuid())
  customerId      String
  contactType     String   // CALL, SMS, EMAIL, MEETING
  subject         String?
  content         String?
  followUpDate    DateTime?
  status          String   @default("COMPLETED")
  createdAt       DateTime @default(now())
  createdBy       String?

  customer        Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([createdAt])
}

// ============================================================================
// APPOINTMENT & QUEUE MODULE
// ============================================================================

/// Lịch hẹn
model Appointment {
  id              String   @id @default(cuid())
  organizationId  String
  branchId        String
  customerId      String
  appointmentNo   String
  serviceId       String?
  serviceName     String?
  appointmentDate DateTime @db.Date
  startTime       String   // HH:mm
  endTime         String?
  source          String   @default("PHONE")
  status          String   @default("SCHEDULED")
  cancellationReason String?
  notes           String?
  checkedInAt     DateTime?
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  updatedBy       String?
  deletedAt       DateTime?

  organization    Organization @relation(fields: [organizationId], references: [id])
  branch          Branch     @relation(fields: [branchId], references: [id])
  customer        Customer   @relation(fields: [customerId], references: [id])
  service         Service?   @relation(fields: [serviceId], references: [id])

  @@index([organizationId])
  @@index([branchId])
  @@index([customerId])
  @@index([appointmentDate])
  @@index([status])
  @@unique([organizationId, appointmentNo])
}

/// Queue ticket
model QueueTicket {
  id              String   @id @default(cuid())
  branchId        String
  ticketNo        String
  customerId      String?
  serviceId       String?
  counterNo       String?
  status          String   @default("WAITING")
  calledAt        DateTime?
  completedAt     DateTime?
  createdAt       DateTime @default(now())

  branch          Branch   @relation(fields: [branchId], references: [id])
  customer        Customer?  @relation(fields: [customerId], references: [id])

  @@index([branchId])
  @@index([ticketNo])
  @@index([status])
  @@index([createdAt])
}

// ============================================================================
// SERVICE & PRICING MODULE
// ============================================================================

/// Nhóm dịch vụ
model ServiceCategory {
  id              String   @id @default(cuid())
  organizationId  String
  parentId        String?
  code            String
  name            String
  nameEn          String?
  description     String?
  order           Int      @default(0)
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  updatedBy       String?
  deletedAt       DateTime?

  organization    Organization @relation(fields: [organizationId], references: [id])
  parent          ServiceCategory? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children        ServiceCategory[] @relation("CategoryHierarchy")
  services        Service[]

  @@index([organizationId])
  @@index([parentId])
  @@index([code])
  @@unique([organizationId, code])
}

/// Dịch vụ
model Service {
  id              String   @id @default(cuid())
  organizationId  String
  categoryId      String?
  code            String
  name            String
  nameEn          String?
  description     String?
  unit            String   @default("Lần")
  duration        Int?
  price           Decimal  @db.Decimal(15, 2)
  vatRate         Decimal? @db.Decimal(5, 2) @default(0)
  isActive        Boolean  @default(true)
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  updatedBy       String?
  deletedAt       DateTime?

  organization    Organization @relation(fields: [organizationId], references: [id])
  category        ServiceCategory? @relation(fields: [categoryId], references: [id])
  priceListItems  PriceListItem[]
  appointments    Appointment[]
  invoiceItems    InvoiceItem[]

  @@index([organizationId])
  @@index([categoryId])
  @@index([code])
  @@unique([organizationId, code])
}

/// Bảng giá
model PriceList {
  id              String   @id @default(cuid())
  organizationId  String
  branchId        String?
  code            String
  name            String
  validFrom       DateTime @db.Date
  validTo         DateTime? @db.Date
  isDefault       Boolean  @default(false)
  status          String   @default("DRAFT")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  updatedBy       String?
  deletedAt       DateTime?

  organization    Organization @relation(fields: [organizationId], references: [id])
  branch          Branch?  @relation(fields: [branchId], references: [id])
  items           PriceListItem[]

  @@index([organizationId])
  @@index([branchId])
  @@index([status])
}

/// Giá dịch vụ trong bảng giá
model PriceListItem {
  id              String   @id @default(cuid())
  priceListId     String
  serviceId       String
  basePrice       Decimal  @db.Decimal(15, 2)
  salePrice       Decimal? @db.Decimal(15, 2)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  priceList       PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  service         Service   @relation(fields: [serviceId], references: [id])

  @@unique([priceListId, serviceId])
  @@index([priceListId])
  @@index([serviceId])
}

// ============================================================================
// CASHIER & FINANCE MODULE
// ============================================================================

/// Ca thu ngân
model CashSession {
  id              String   @id @default(cuid())
  branchId        String
  cashierId       String
  sessionNo       String
  openTime        DateTime
  closeTime       DateTime?
  openingBalance  Decimal  @db.Decimal(15, 2) @default(0)
  closingBalance  Decimal? @db.Decimal(15, 2)
  expectedBalance Decimal? @db.Decimal(15, 2)
  difference      Decimal? @db.Decimal(15, 2)
  status          String   @default("OPEN")
  openedBy        String?
  closedBy        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  branch          Branch   @relation(fields: [branchId], references: [id])
  invoices        Invoice[]

  @@index([branchId])
  @@index([cashierId])
  @@index([sessionNo])
  @@index([status])
  @@unique([branchId, sessionNo])
}

/// Hóa đơn/Phiếu thu
model Invoice {
  id              String   @id @default(cuid())
  organizationId  String
  branchId        String
  cashSessionId   String?
  customerId      String?
  invoiceNo       String
  invoiceType     String   @default("INVOICE")
  issueDate       DateTime @default(now())
  items           Json
  subtotal        Decimal  @db.Decimal(15, 2)
  discountAmount  Decimal  @db.Decimal(15, 2) @default(0)
  vatAmount       Decimal  @db.Decimal(15, 2) @default(0)
  totalAmount     Decimal  @db.Decimal(15, 2)
  paidAmount      Decimal  @db.Decimal(15, 2) @default(0)
  balance         Decimal  @db.Decimal(15, 2)
  paymentStatus   String   @default("UNPAID")
  paymentMethods  Json?
  notes           String?
  status          String   @default("DRAFT")
  cancelledAt     DateTime?
  cancelledBy     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  updatedBy       String?
  deletedAt       DateTime?

  organization    Organization @relation(fields: [organizationId], references: [id])
  branch          Branch     @relation(fields: [branchId], references: [id])
  cashSession     CashSession? @relation(fields: [cashSessionId], references: [id])
  customer        Customer?  @relation(fields: [customerId], references: [id])
  itemsDetail     InvoiceItem[]
  payments        Payment[]

  @@index([organizationId])
  @@index([branchId])
  @@index([invoiceNo])
  @@index([customerId])
  @@index([issueDate])
  @@index([paymentStatus])
  @@unique([organizationId, invoiceNo])
}

/// Chi tiết hóa đơn
model InvoiceItem {
  id              String   @id @default(cuid())
  invoiceId       String
  serviceId       String?
  itemName        String
  quantity        Decimal  @db.Decimal(10, 2) @default(1)
  unitPrice       Decimal  @db.Decimal(15, 2)
  discount        Decimal  @db.Decimal(15, 2) @default(0)
  vatRate         Decimal  @db.Decimal(5, 2) @default(0)
  amount          Decimal  @db.Decimal(15, 2)
  createdAt       DateTime @default(now())

  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  service         Service? @relation(fields: [serviceId], references: [id])

  @@index([invoiceId])
  @@index([serviceId])
}

/// Thanh toán
model Payment {
  id              String   @id @default(cuid())
  invoiceId       String
  paymentNo       String
  paymentDate     DateTime @default(now())
  paymentMethod   String   // CASH, BANK_TRANSFER, QR_CODE, CARD
  amount          Decimal  @db.Decimal(15, 2)
  currency        String   @default("VND")
  transactionRef  String?
  notes           String?
  status          String   @default("COMPLETED")
  createdAt       DateTime @default(now())
  createdBy       String?

  invoice         Invoice  @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@index([paymentNo])
  @@index([paymentDate])
  @@unique([paymentNo])
}

// ============================================================================
// INVENTORY MODULE
// ============================================================================

/// Kho
model Warehouse {
  id              String   @id @default(cuid())
  organizationId  String
  branchId        String
  code            String
  name            String
  nameEn          String?
  managerId       String?
  type            String   @default("GENERAL")
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  updatedBy       String?
  deletedAt       DateTime?

  organization    Organization @relation(fields: [organizationId], references: [id])
  branch          Branch   @relation(fields: [branchId], references: [id])
  items           InventoryItem[]
  stockTransactions StockTransaction[]
  stockBalances   StockBalance[]

  @@index([organizationId])
  @@index([branchId])
  @@index([code])
  @@unique([organizationId, code])
}

/// Danh mục hàng hóa/vật tư
model InventoryItem {
  id              String   @id @default(cuid())
  organizationId  String
  categoryId      String?
  code            String
  name            String
  nameEn          String?
  description     String?
  unit            String
  barcode         String?
  manufacturer    String?
  minStock        Decimal  @db.Decimal(10, 2) @default(0)
  standardCost    Decimal? @db.Decimal(15, 2)
  sellingPrice    Decimal? @db.Decimal(15, 2)
  hasBatch        Boolean  @default(false)
  hasExpiry       Boolean  @default(false)
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  updatedBy       String?
  deletedAt       DateTime?

  organization    Organization @relation(fields: [organizationId], references: [id])
  stockTransactions StockTransaction[]
  stockBalances   StockBalance[]
  purchaseOrderItems PurchaseOrderItem[]

  @@index([organizationId])
  @@index([code])
  @@index([barcode])
  @@index([status])
  @@unique([organizationId, code])
}

/// Giao dịch kho
model StockTransaction {
  id              String   @id @default(cuid())
  warehouseId     String
  itemId          String
  transactionType String   // IN, OUT, TRANSFER_IN, TRANSFER_OUT, ADJUSTMENT
  referenceType   String?
  referenceId     String?
  batchNo         String?
  expiryDate      DateTime?
  quantity        Decimal  @db.Decimal(10, 2)
  unitCost        Decimal? @db.Decimal(15, 2)
  notes           String?
  transactionDate DateTime @default(now())
  createdAt       DateTime @default(now())
  createdBy       String?

  warehouse       Warehouse @relation(fields: [warehouseId], references: [id])
  item            InventoryItem @relation(fields: [itemId], references: [id])

  @@index([warehouseId])
  @@index([itemId])
  @@index([transactionType])
  @@index([transactionDate])
}

/// Tồn kho
model StockBalance {
  id              String   @id @default(cuid())
  warehouseId     String
  itemId          String
  batchNo         String?
  expiryDate      DateTime?
  quantity        Decimal  @db.Decimal(10, 2) @default(0)
  reservedQuantity Decimal @db.Decimal(10, 2) @default(0)
  unitCost        Decimal? @db.Decimal(15, 2)
  totalValue      Decimal? @db.Decimal(15, 2)
  lastCountedAt   DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  warehouse       Warehouse @relation(fields: [warehouseId], references: [id])
  item            InventoryItem @relation(fields: [itemId], references: [id])

  @@unique([warehouseId, itemId, batchNo])
  @@index([warehouseId])
  @@index([itemId])
}

// ============================================================================
// PROCUREMENT MODULE
// ============================================================================

/// Nhà cung cấp
model Supplier {
  id              String   @id @default(cuid())
  organizationId  String
  code            String
  name            String
  taxCode         String?
  address         String?
  phone           String?
  email           String?
  contactPerson   String?
  contactPhone    String?
  rating          Decimal? @db.Decimal(3, 2)
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  updatedBy       String?
  deletedAt       DateTime?

  organization    Organization @relation(fields: [organizationId], references: [id])
  purchaseOrders  PurchaseOrder[]

  @@index([organizationId])
  @@index([code])
  @@index([status])
  @@unique([organizationId, code])
}

/// Yêu cầu mua hàng
model ProcurementRequest {
  id              String   @id @default(cuid())
  organizationId  String
  branchId        String
  requestNo       String
  requesterId     String
  departmentId    String?
  requestDate     DateTime @default(now())
  requiredDate    DateTime?
  items           Json
  totalEstimated  Decimal? @db.Decimal(15, 2)
  priority        String   @default("NORMAL")
  purpose         String?
  status          String   @default("DRAFT")
  currentApprovalLevel Int @default(0)
  approvedBy      String?
  approvedAt      DateTime?
  rejectionReason String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  updatedBy       String?
  deletedAt       DateTime?

  organization    Organization @relation(fields: [organizationId], references: [id])
  branch          Branch     @relation(fields: [branchId], references: [id])

  @@index([organizationId])
  @@index([branchId])
  @@index([requestNo])
  @@index([status])
  @@unique([organizationId, requestNo])
}

/// Đơn mua hàng (PO)
model PurchaseOrder {
  id              String   @id @default(cuid())
  organizationId  String
  branchId        String
  supplierId      String
  poNo            String
  orderDate       DateTime @default(now())
  expectedDeliveryDate DateTime?
  items           Json
  subtotal        Decimal  @db.Decimal(15, 2)
  vatAmount       Decimal  @db.Decimal(15, 2) @default(0)
  totalAmount     Decimal  @db.Decimal(15, 2)
  paymentTerms    String?
  notes           String?
  status          String   @default("DRAFT")
  sentAt          DateTime?
  confirmedAt     DateTime?
  receivedQty     Decimal? @db.Decimal(10, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  updatedBy       String?
  deletedAt       DateTime?

  organization    Organization @relation(fields: [organizationId], references: [id])
  branch          Branch     @relation(fields: [branchId], references: [id])
  supplier        Supplier   @relation(fields: [supplierId], references: [id])
  itemsDetail     PurchaseOrderItem[]

  @@index([organizationId])
  @@index([branchId])
  @@index([supplierId])
  @@index([poNo])
  @@index([status])
  @@unique([organizationId, poNo])
}

/// Chi tiết đơn mua hàng
model PurchaseOrderItem {
  id              String   @id @default(cuid())
  purchaseOrderId String
  itemId          String?
  itemName        String
  itemCode        String?
  quantity        Decimal  @db.Decimal(10, 2)
  receivedQuantity Decimal @db.Decimal(10, 2) @default(0)
  unit            String?
  unitPrice       Decimal  @db.Decimal(15, 2)
  amount          Decimal  @db.Decimal(15, 2)
  batchNo         String?
  expiryDate      DateTime?
  notes           String?
  createdAt       DateTime @default(now())

  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  item            InventoryItem? @relation(fields: [itemId], references: [id])

  @@index([purchaseOrderId])
  @@index([itemId])
}

// ============================================================================
// ASSET MANAGEMENT MODULE
// ============================================================================

/// Tài sản/Thiết bị
model Asset {
  id              String   @id @default(cuid())
  organizationId  String
  branchId        String
  assetCode       String
  name            String
  nameEn          String?
  categoryId      String?
  serialNo        String?
  model           String?
  manufacturer    String?
  purchaseDate    DateTime?
  purchasePrice   Decimal? @db.Decimal(15, 2)
  warrantyStartDate DateTime?
  warrantyEndDate DateTime?
  location        String?
  departmentId    String?
  assignedTo      String?
  condition       String   @default("GOOD")
  status          String   @default("AVAILABLE")
  lastMaintenanceDate DateTime?
  nextMaintenanceDate DateTime?
  maintenanceInterval Int?
  specifications  Json?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  updatedBy       String?
  deletedAt       DateTime?

  organization    Organization @relation(fields: [organizationId], references: [id])
  branch          Branch     @relation(fields: [branchId], references: [id])
  assignments     AssetAssignment[]
  maintenances    AssetMaintenance[]

  @@index([organizationId])
  @@index([branchId])
  @@index([assetCode])
  @@index([status])
  @@unique([organizationId, assetCode])
}

/// Phân bổ tài sản
model AssetAssignment {
  id              String   @id @default(cuid())
  assetId         String
  employeeId      String
  assignmentDate  DateTime @default(now())
  returnDate      DateTime?
  condition       String?
  notes           String?
  createdAt       DateTime @default(now())
  createdBy       String?

  asset           Asset    @relation(fields: [assetId], references: [id])
  employee        Employee @relation(fields: [employeeId], references: [id])

  @@index([assetId])
  @@index([employeeId])
}

/// Bảo trì tài sản
model AssetMaintenance {
  id              String   @id @default(cuid())
  assetId         String
  maintenanceType String   // PREVENTIVE, CORRECTIVE, EMERGENCY
  title           String
  description     String?
  scheduledDate   DateTime?
  completedDate   DateTime?
  vendorName      String?
  cost            Decimal? @db.Decimal(15, 2)
  findings        String?
  actionsTaken    String?
  status          String   @default("SCHEDULED")
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  updatedBy       String?

  asset           Asset    @relation(fields: [assetId], references: [id])

  @@index([assetId])
  @@index([scheduledDate])
  @@index([status])
}

// ============================================================================
// INTERNAL TICKETS & TASKS MODULE
// ============================================================================

/// Ticket nội bộ
model InternalTicket {
  id              String   @id @default(cuid())
  organizationId  String
  ticketNo        String
  type            String   // IT, HR, ADMIN, MAINTENANCE, OTHER
  priority        String   @default("NORMAL")
  title           String
  description     String?
  reporterId      String?
  assigneeId      String?
  dueDate         DateTime?
  status          String   @default("OPEN")
  resolution      String?
  resolvedAt      DateTime?
  satisfaction    Int?
  feedback        String?
  tags            Json?
  attachments     Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  updatedBy       String?
  deletedAt       DateTime?

  organization    Organization @relation(fields: [organizationId], references: [id])
  comments        TicketComment[]

  @@index([organizationId])
  @@index([ticketNo])
  @@index([type])
  @@index([status])
  @@index([assigneeId])
  @@unique([organizationId, ticketNo])
}

/// Comment ticket
model TicketComment {
  id              String   @id @default(cuid())
  ticketId        String
  authorId        String
  content         String
  attachments     Json?
  isInternal      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  ticket          InternalTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([authorId])
}

// ============================================================================
// SYSTEM MODULES
// ============================================================================

/// Audit log
model AuditLog {
  id              String   @id @default(cuid())
  organizationId  String?
  userId          String?
  action          String
  entity          String
  entityId        String?
  changes         Json?
  ipAddress       String?
  userAgent       String?
  details         String?
  timestamp       DateTime @default(now())

  organization    Organization? @relation(fields: [organizationId], references: [id])
  user            User?    @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([timestamp])
}

/// Activity log
model ActivityLog {
  id              String   @id @default(cuid())
  userId          String
  activity        String
  entity          String?
  entityId        String?
  details         Json?
  ipAddress       String?
  timestamp       DateTime @default(now())

  @@index([userId])
  @@index([activity])
  @@index([timestamp])
}

/// System settings
model SystemSetting {
  id              String   @id @default(cuid())
  organizationId  String?
  key             String
  value           Json
  type            String   @default("STRING")
  description     String?
  isPublic        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  updatedBy       String?

  @@unique([organizationId, key])
  @@index([organizationId])
  @@index([key])
}

/// Notification
model Notification {
  id              String   @id @default(cuid())
  userId          String
  type            String   // INFO, WARNING, ERROR, SUCCESS
  title           String
  message         String
  data            Json?
  isRead          Boolean  @default(false)
  readAt          DateTime?
  expiresAt       DateTime?
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

/// Attachment
model Attachment {
  id              String   @id @default(cuid())
  organizationId  String
  entityType      String
  entityId        String
  fileName        String
  originalName    String
  mimeType        String
  size            Int
  url             String
  uploadedBy      String?
  createdAt       DateTime @default(now())

  @@index([organizationId])
  @@index([entityType, entityId])
}
