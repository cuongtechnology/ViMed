# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/clinic_dev?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-change-in-production"

# Redis (for caching and jobs)
REDIS_URL="redis://localhost:6379"

# File Storage (S3-compatible)
S3_ENDPOINT=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET="clinic-uploads"
S3_REGION="ap-southeast-1"

# Application
APP_NAME="Clinic Management System"
APP_URL="http://localhost:3000"
TIMEZONE="Asia/Ho_Chi_Minh"

# Email (optional)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@clinic.com"

# SMS (optional)
SMS_PROVIDER=""
SMS_API_KEY=""

# Logging
LOG_LEVEL="info"
SENTRY_DSN=""
