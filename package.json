{
  "name": "clinic-management-system",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @clinic/web dev",
    "build": "pnpm --filter @clinic/web build",
    "start": "pnpm --filter @clinic/web start",
    "lint": "pnpm --filter @clinic/web lint",
    "test": "pnpm --filter @clinic/web test",
    "db:generate": "pnpm --filter @clinic/database db:generate",
    "db:migrate": "pnpm --filter @clinic/database db:migrate",
    "db:push": "pnpm --filter @clinic/database db:push",
    "db:seed": "pnpm --filter @clinic/database db:seed",
    "db:studio": "pnpm --filter @clinic/database db:studio"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "@types/node": "^20.11.0",
    "prettier": "^3.2.0",
    "eslint": "^8.57.0"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18.0.0"
  }
}
